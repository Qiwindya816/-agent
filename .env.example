DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
API_TIMEOUT=10
MAX_RETRIES=1

# MCP 默认关闭。AMAP_MCP_TOOL_MAP 的键是本地白名单别名，值是服务端真实工具名。
MCP_ENABLED=false
AMAP_MCP_URL=
AMAP_MCP_TOKEN=
AMAP_MCP_TOOL_MAP={}
MCP_TIMEOUT_SECONDS=30
MCP_SSE_READ_TIMEOUT_SECONDS=300

# 12306 / 铁路 MCP。申请完成后填写 URL，必要时填写 Token；工具映射先留空，
# 后续通过服务端 tools/list 结果确认真实工具名后再配置。
RAILWAY_MCP_ENABLED=false
RAILWAY_MCP_URL=
RAILWAY_MCP_TOKEN=
RAILWAY_MCP_TOOL_MAP={}
RAILWAY_MCP_TIMEOUT_SECONDS=30
RAILWAY_MCP_SSE_READ_TIMEOUT_SECONDS=300

# Database. 默认使用本地 SQLite 便于开发；生产切换为 PostgreSQL/pgvector。
DATABASE_URL=sqlite+pysqlite:///./travelmind.db
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Context and checkpoint
CHECKPOINT_BACKEND=postgresql
MEMORY_RECENT_TURNS=8
MEMORY_SUMMARY_AFTER_TURNS=12
MEMORY_MAX_CONTEXT_TOKENS=6000
MEMORY_SUMMARY_MAX_TOKENS=800

# RAG and embeddings
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_GEO_TOP_K=20
RAG_TEMPLATE_TOP_K=20
RAG_RRF_TOP_K=15
RAG_MIN_RELEVANCE=0.0

# Long-term memory
MEMORY_RETRIEVAL_TOP_K=8
MEMORY_INJECTION_TOP_K=5
MEMORY_MIN_RELEVANCE=0.50
MEMORY_SEMANTIC_WRITE_THRESHOLD=0.85
MEMORY_PROCEDURAL_WRITE_THRESHOLD=0.85
MEMORY_MIN_EVIDENCE_COUNT=2

# API
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
