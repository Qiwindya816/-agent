# Copy to .env on the deployment host. Never commit the populated file.
POSTGRES_DB=travelmind
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=replace-with-a-long-random-password
TRAVELMIND_PORT=8080

DATABASE_URL=postgresql+psycopg://travelmind:replace-me@postgres:5432/travelmind
CHECKPOINT_BACKEND=postgresql
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=

MCP_ENABLED=false
AMAP_MCP_URL=
AMAP_MCP_TOKEN=
AMAP_MCP_TOOL_MAP={}
RAILWAY_MCP_ENABLED=false
RAILWAY_MCP_URL=
RAILWAY_MCP_TOKEN=
RAILWAY_MCP_TOOL_MAP={}

VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
API_CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=true
LOG_TO_STDOUT=true
